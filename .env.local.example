# Supabase — create a project at https://supabase.com and paste the values below.
# Copy this file to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

