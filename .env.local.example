# Supabase — create a project at https://supabase.com and paste the values below.
# Copy this file to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service-role key (Dashboard → Settings → API).
# REQUIRED for donations (server reads/writes the RLS-protected donations table).
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin, used to build the payment redirect URL.
# e.g. https://lanky.ng  (leave blank in dev to auto-detect the host)
NEXT_PUBLIC_SITE_URL=

# Flutterwave (Dashboard → Settings → API Keys). REQUIRED for donations.
FLW_SECRET_KEY=
# Webhook secret hash (Dashboard → Settings → Webhooks → "Secret hash").
# Must match the value configured for the webhook URL: /api/flutterwave/webhook
FLW_SECRET_HASH=

# Admin dashboard (/admin) uses Supabase Auth. Create team accounts in the
# Supabase dashboard (Authentication → Users) and DISABLE public sign-ups.
# Optional allowlist — only these emails may access /admin (comma-separated).
# If blank, any authenticated Supabase user is allowed.
ADMIN_EMAILS=

# Temporary first-admin setup. Set a long random value, visit /admin/setup to
# create the first account, then REMOVE this (the page also self-disables once
# an admin exists). Requires SUPABASE_SERVICE_ROLE_KEY.
ADMIN_SETUP_TOKEN=

# Email notifications (Resend) — get a key at https://resend.com
RESEND_API_KEY=
# Where new submissions are emailed (defaults off if unset)
NOTIFY_EMAIL=
