# SUPABASE_SERVICE_ROLE_KEY=

# Payment gateway (TBD: Flutterwave or Paystack)
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# PAYSTACK_SECRET_KEY=
